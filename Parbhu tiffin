    <!-- Interactive Scripts -->
    <script>
        // Calculate Order Price
        function calculateTotal() {
            const mealTypeRadios = document.getElementsByName('mealType');
            let selectedMeal = 'Vegetarian';
            let pricePerMeal = 70;

            for (const radio of mealTypeRadios) {
                if (radio.checked) {
                    selectedMeal = radio.value;
                    pricePerMeal = selectedMeal === 'Vegetarian' ? 70 : 90;
                    break;
                }
            }
            const count = parseInt(document.getElementById('mealCount').value) || 1;
            const total = pricePerMeal * count;

            document.getElementById('total-price').innerText = `₹${total}`;

            const message = `Hi Prabhu Tifin Service!%0A%0AI would like to place an order:%0A- Meal Type: ${selectedMeal}%0A- Quantity: ${count} meal(s)%0A- Total Amount: ₹${total}%0A%0APlease let me know the payment and delivery details.`;
            document.getElementById('whatsapp-btn').href = `https://wa.me/8299787909?text=${message}`;
        }

        // Handle Review Submission (Demo)
        function submitReview(event) {
            event.preventDefault();
            alert("Thank you for your review! It will be posted after approval from Prabhu Tifin Service.");
            document.getElementById('reviewForm').reset();
        }
    </script>
